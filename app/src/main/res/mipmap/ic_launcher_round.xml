<!-- Launcher icon for Android 5-7 (Android 8+ uses the adaptive icon in mipmap-anydpi-v26). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient android:angle="270" android:startColor="#14305A" android:endColor="#071226" />
        </shape>
    </item>
    <item android:drawable="@drawable/ic_launcher_foreground"
        android:left="-12dp" android:top="-12dp" android:right="-12dp" android:bottom="-12dp" />
</layer-list>
